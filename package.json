{
	"name": "electron-timber",
	"version": "1.0.0",
	"description": "Pretty logger for Electron apps",
	"license": "MIT",
	"repository": "sindresorhus/electron-timber",
	"funding": "https://github.com/sponsors/sindresorhus",
	"author": "Sindre Sorhus <sindresorhus@gmail.com> (https://sindresorhus.com)",
	"type": "module",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		}
	},
	"sideEffects": true,
	"engines": {
		"node": ">=22.12"
	},
	"scripts": {
		"test": "xo && node --test test/*.test.js",
		"start": "electron test/fixture",
		"make-screenshot": "svg-term --at=2000 --command=\"electron test/fixture\" --out=screenshot.svg --window --no-cursor --height=8"
	},
	"files": [
		"index.js",
		"index.d.ts",
		"lib",
		"preload.mjs"
	],
	"keywords": [
		"electron",
		"logger",
		"logging",
		"log",
		"timber",
		"lumber",
		"dev",
		"development",
		"stdout",
		"stderr",
		"stream",
		"error",
		"debug",
		"pretty",
		"console"
	],
	"dependencies": {
		"auto-bind": "^5.0.1",
		"chalk": "^6.0.0",
		"randoma": "^2.0.1",
		"split2": "^4.2.0"
	},
	"devDependencies": {
		"electron": "^44.4.5",
		"svg-term-cli": "^2.1.1",
		"xo": "^5.0.1"
	}
}
